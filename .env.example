# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# Model provider: set one key. Google AI Studio free tier works for testing.
# GOOGLE_GENERATIVE_AI_API_KEY=
# ANTHROPIC_API_KEY=
# Pin the agent model (gemini-3.8-flash timed out on the free tier; lite works)
# AGENT_MODEL=gemini-3.5-flash-lite
